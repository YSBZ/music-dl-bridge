FROM --platform=$BUILDPLATFORM golang:1.25 AS builder
WORKDIR /src
ARG TARGETOS=linux
ARG TARGETARCH=amd64
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/music-dl ./cmd/music-dl

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata ffmpeg
WORKDIR /home/appuser
ENV TZ=Asia/Shanghai
COPY --from=builder /out/music-dl /usr/local/bin/music-dl
COPY LICENSE /usr/share/licenses/music-dl-bridge/LICENSE
# Keep the established NAS root ownership; never recursively chown mounted media.
EXPOSE 8080
ENTRYPOINT ["music-dl"]
CMD ["web", "--port", "8080", "--no-browser"]
